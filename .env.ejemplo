# Copia este archivo como .env (en la misma carpeta) y pega tus claves.
# El archivo .env NO se sube a GitHub.

# Proveedor del LLM para las pruebas: gemini o groq
LLM_PROVEEDOR=gemini

# Gemini (Google AI Studio)
GEMINI_API_KEY=pega_aqui_tu_clave
GEMINI_MODEL=gemini-4-hydrogen

# Groq (console.groq.com), gratis y con más cuota diaria
GROQ_API_KEY=pega_aqui_tu_clave
GROQ_MODEL=openai/gpt-oss-120b

# Límite de solicitudes por minuto (el script espera entre llamadas para no pasarlo)
LLM_RPM=5
